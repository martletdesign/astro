---
import Layout from './Layout.astro';
import Container from './Container.astro';
import PageHeader from './PageHeader.astro';
import Sidebar from './Sidebar.astro';
interface Props { stylesheet?: string; title: string; documentTitle?: string; description?: string; summary?: string; eyebrow?: string; mode?: 'light' | 'dark'; lang?: string; mainId?: string; class?: string; bodyClass?: string; sidebarLabel?: string; }
const { stylesheet, title, documentTitle = title, description, summary, eyebrow, mode = 'light', lang = 'en', mainId = 'main-content', class: className, bodyClass, sidebarLabel = 'Supporting information' } = Astro.props;
---
<Layout stylesheet={stylesheet} title={documentTitle} description={description} mode={mode} lang={lang} mainId={mainId} mainTabindex={-1} class={className} bodyClass={bodyClass}>
  <slot name="head" slot="head" />
  <slot name="header" slot="header" />
  <slot name="footer" slot="footer" />
  <slot name="body-end" slot="body-end" />
  <PageHeader title={title} summary={summary} eyebrow={eyebrow}><slot name="metadata" /></PageHeader>
  <div class="martlet-page-body"><Container width={Astro.slots.has('sidebar') || Astro.slots.has('contents') ? 'content' : 'reading'}>
    <div class="martlet-reading-context"><div class:list={[Astro.slots.has('contents') && 'martlet-reading-layout']}>
    {Astro.slots.has('contents') && <div class="martlet-reading-layout__contents"><slot name="contents" /></div>}
    <div class="martlet-reading-layout__body">
    {Astro.slots.has('sidebar') ? <Sidebar side="end" sidebarLabel={sidebarLabel}><Fragment slot="sidebar"><slot name="sidebar" /></Fragment><article class="martlet-prose"><slot /></article></Sidebar> : <article class="martlet-prose"><slot /></article>}
    </div></div></div>
  </Container></div>
</Layout>
