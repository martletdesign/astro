---
const {name='Martlet Astro',home,href=(url)=>url,current} = Astro.props;
const links=[['The Language','/language/','language'],['Examples','/examples/','index'],['Journal','/journal/','journal'],['Use This Template','/setup/','setup']];
---
<header class="site-header mast nightjar-header" data-source-nav><div class="container header-inner"><a class="brand nightjar-brand" href={home}><img src={href('/assets/mark.svg')} alt="" width="42" height="42"/><span>{name}</span></a><button class="menu-button nightjar-menu" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button><nav id="site-nav" aria-label="Primary navigation"><ul>{links.map(([title,url,id])=><li class="nav-item"><a class="nav-link" href={href(url)} aria-current={current===id?'page':undefined}>{title}</a></li>)}<li><button type="button" class="appearance-toggle nightjar-appearance" data-appearance-toggle aria-pressed="false">Dark mode</button></li></ul></nav></div></header>
