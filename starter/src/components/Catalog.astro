---
import catalog from '../../page-archetypes/content/catalog.json';
import {supported} from '../supported.mjs';
const {href}=Astro.props;
const categories=[...new Set(catalog.pages.map(page=>page.category))];
const slug=value=>value.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
---
<div class="example-catalog-intro"><p>One content collection, two independent design languages. Explore {catalog.pages.length} complete recipes, reusable sections, and local application specimens.</p><p class="example-notice">{catalog.fixture.notice}</p></div>
<nav class="example-category-nav" aria-label="Example categories">{categories.map(category=><a href={'#'+slug(category)}>{category}</a>)}</nav>
{categories.map(category=><section class="example-section" aria-labelledby={slug(category)}><div class="example-section__label"><h2 id={slug(category)}>{category}</h2></div><div class="example-section__body"><div class="example-cards">{catalog.pages.filter(page=>page.category===category).map(page=><article class="example-card"><p class="example-help">{page.semantic_class.replaceAll('-',' ').replace(/^./,letter=>letter.toUpperCase())}</p><h3>{supported.includes(page.id)?<a href={href('/examples/'+page.id+'/')}>{page.title}</a>:<span>{page.title} (not yet available in this Astro preview)</span>}</h3><p>{page.summary}</p></article>)}</div></div></section>)}
<section class="example-section" aria-labelledby="experimental-applications"><div class="example-section__label"><h2 id="experimental-applications">Experimental applications</h2></div><div class="example-section__body"><p><a href={href('/examples/scientific-workspace/')}>Thermal analysis</a> · Explore an illustrative local calculation.</p></div></section>
