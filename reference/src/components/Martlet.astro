---
import {Button} from '@martlet/astro';
import SourceHeader from './SourceHeader.astro';import SourceFooter from './SourceFooter.astro';import SourceMasthead from './SourceMasthead.astro';import Content from './Content.astro';import {heroFor} from '../reference.mjs';
const {page,href,base,renderContent=true}=Astro.props,hero=heroFor(page),documentFrame=['document','reading'].includes(page.composition),isExample=!!page.semantic_class;
---
<!doctype html><html lang="en" data-appearance="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{page.title} · Martlet Astro</title><meta name="description" content={page.summary}/><link rel="icon" href={href('/assets/mark.svg')}/><script is:inline>try{document.documentElement.dataset.appearance=localStorage.getItem('design-appearance')==='dark'?'dark':'light'}catch{}</script><link rel="stylesheet" href={href("/assets/css/fonts.css")}/><link rel="stylesheet" href={href("/assets/css/martlet.css")}/><slot name="head"/></head>
<body class:list={['martlet',{'has-panoramic-hero':!!hero.image,'dashboard-page':!!page.dashboard}]} data-martlet="light" data-hero-variant={hero.variant}><a class="skip-link" href="#main">Skip to content</a><SourceHeader home={href('/')} href={href} current={page.id}/><main id="main" tabindex="-1">{!page.dashboard&&<SourceMasthead page={page} href={href}/>}
{page.dashboard?<slot/>:isExample?<div class:list={['example-root',`example-frame--${page.composition||'landing'}`,{'example-reference-exemplar':['faq','changelog','dashboard-components'].includes(page.id)}]} data-example={page.id} data-semantic-class={page.semantic_class}><div class:list={['example-wrap',{'example-reading':documentFrame}]}>
{page.id!=='index'&&!page.dashboard&&<nav class="example-breadcrumb" aria-label="Breadcrumb"><a href={href('/')}>Overview</a><span aria-hidden="true">/</span><a href={href('/examples/')}>Examples</a><span aria-hidden="true">/</span><span aria-current="page">{page.semantic_class.replaceAll('-',' ')}</span></nav>}
<div class:list={{'example-document':page.composition==='document','example-report-layout':page.id==='report'}}>{(documentFrame||page.id==='report')&&<nav class:list={['example-local-index',{'toc':page.id==='article'}]} aria-label={page.id==='report'?'Report sections':'On this page'}><p class="eyebrow">On this page</p><ol>{page.sections.map(section=><li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>}<div><article aria-labelledby={page.dashboard?undefined:'page-title'}>{renderContent&&!page.dashboard&&<Content page={page} href={href} base={base} Button={Button}/>}<slot/></article></div></div>
{page.id!=='index'&&!page.dashboard&&<p class="example-port-note">A {page.semantic_class.replaceAll('-',' ')} recipe in Martlet. <a href={href('/examples/integrations/')}>Capabilities and integration boundaries</a> · <a href={href('/examples/')}>All examples</a></p>}
</div></div>:<section class="section"><div class="container jekyll-document">{page.toc&&<nav class="page-index" aria-label="On this page"><p class="eyebrow">On this page</p><ul>{page.toc.map(item=><li class="page-index__section"><a href={'#'+item.id}>{item.title}</a></li>)}</ul></nav>}<article class:list={["content editorial-content",{"journal-list":page.id==='journal'}]}><slot/></article></div></section>}
</main>{!page.dashboard&&<SourceFooter href={href}/>}<script is:inline src={href('/assets/js/shell.js')} defer></script><slot name="body-end"/></body></html>
