---
import Button from '@nightjar/button';

const {href,current} = Astro.props;
const entries=[{id:'analytics',label:'Analytics'},{id:'administration',label:'Administration'},{id:'operations',label:'Operations'}];
---
<aside class="dash-sidebar" aria-label="Dashboard workspace">
  <p>Northlight · Workspace</p>
  <Button class="dash-nav-toggle" type="button" aria-controls="dashboard-nav" aria-expanded="false" hidden>Dashboard navigation</Button>
  <nav id="dashboard-nav" aria-label="Dashboard navigation"><ul>{entries.map(entry=><li>{entry.available===false ? <span>{entry.label} (not yet available here)</span> : <a href={href(`/examples/dashboard-${entry.id}/`)} aria-current={current===entry.id?'page':undefined}>{entry.label}</a>}</li>)}</ul><p class="dash-sidebar__caption">One dataset. Two design languages.</p><a href={href('/examples/')}>All page examples</a>
    <div class="dashboard-ownership">
      <a class="dashboard-ownership__identity" href="https://jameshoward.us/" aria-label="James Howard website">
        <img src={href('/assets/owner.svg')} alt="" width="56" height="56"/>
        <span><strong>Martlet Astro</strong><br/>A website of James Howard</span>
      </a>
      <p>Copyright © 2026 <span>James P. Howard, II</span></p>
    </div>
  </nav>
</aside>
